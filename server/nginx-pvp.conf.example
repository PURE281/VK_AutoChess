# Nginx reverse proxy for the Valkyrie PVP WebSocket server.
# TLS is REQUIRED: the game is served over HTTPS and browsers block plain ws://.
#
# This file is the INITIAL HTTP-only config. certbot will add the 443/SSL
# server block automatically, exactly like the other "managed by Certbot"
# sites on this server. Steps:
#
#   1. Create the DNS A record: pvp.pure81.site -> this server's IP
#   2. cp server/nginx-pvp.conf.example /etc/nginx/conf.d/valkyrie-pvp.conf
#   3. nginx -t && systemctl reload nginx
#   4. certbot --nginx -d pvp.pure81.site
#      (certbot creates the 443 block with certificates and redirects 80->443)
#
# Existing server blocks are untouched: nginx routes by server_name.

server {
    listen 80;
    server_name pvp.pure81.site;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;

        # WebSocket upgrade headers — the essential part
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # Matches can idle in planning for a long time; avoid 60s cutoff
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
